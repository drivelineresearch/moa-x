{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoA Final Decisions v2",
  "description": "Machine-readable companion to final-plan.md. It records which proposer steps and refiner findings support each aggregated step so report.html can explain how the final plan was formed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "summary",
    "confidence",
    "steps",
    "rejected_inputs",
    "outcome",
    "open_questions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "files_touched",
          "decision",
          "adjudication",
          "proposer_refs",
          "refiner_refs",
          "counterargument",
          "constraints",
          "uncertainties",
          "validation",
          "evidence",
          "supporting_claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "files_touched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "revised",
              "new",
              "deferred"
            ]
          },
          "adjudication": {
            "type": "string",
            "minLength": 1
          },
          "proposer_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/proposerRef"
            }
          },
          "refiner_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/refinerRef"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterargument": {
            "type": "string",
            "description": "Strongest contrary evidence or minority argument; explain why it does or does not change this decision."
          },
          "evidence": {
            "type": "array",
            "description": "Claims this step depends on, each backed by either a code citation or an external source. Refiners will verify these.",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "file",
                "line",
                "url",
                "snippet",
                "claim"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "code",
                    "external",
                    "attachment"
                  ],
                  "description": "code = citation from the local repo. external = citation from a web source."
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Repo-relative path. Required when type=code; set to null when type=external."
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "description": "Line number in the file. Required when type=code; set to null when type=external."
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "URL of the external source. Required when type=external; set to null when type=code."
                },
                "snippet": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Short verbatim quote from the source that supports the claim. Required for external; optional-but-null for code."
                },
                "claim": {
                  "type": "string",
                  "description": "One atomic proposition this evidence proves or supports. Always required.",
                  "minLength": 1
                }
              }
            }
          },
          "supporting_claims": {
            "type": "array",
            "maxItems": 3,
            "description": "Only the 1-3 load-bearing factual premises this decision actually depends on. Prefer independently checked claims. Proposer_refs are provenance; this array alone selects adopted claims.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposer",
                "claim_index_path"
              ],
              "properties": {
                "proposer": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "claim_index_path": {
                  "type": "string",
                  "pattern": "^plan\\[[0-9]+\\]\\.evidence\\[[0-9]+\\]$"
                }
              }
            }
          }
        }
      }
    },
    "rejected_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposer",
          "step_index",
          "reason",
          "refiner_refs"
        ],
        "properties": {
          "proposer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "step_index": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "refiner_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/refinerRef"
            }
          }
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ready",
        "needs_revision",
        "insufficient_evidence"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "proposerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "step_index",
        "relationship",
        "note",
        "evidence_indices"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "relationship": {
          "type": "string",
          "enum": [
            "adopted",
            "adapted"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "evidence_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Exact zero-based evidence indices supporting this decision. Select only the essential premises actually adopted, never every sibling claim of an adapted step.",
          "maxItems": 3
        }
      }
    },
    "refinerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "kind",
        "index",
        "note"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "verification",
            "missing_step",
            "incorrect_step",
            "disagreement",
            "synthesis_recommendation"
          ]
        },
        "index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

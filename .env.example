# MoA-X harness env overrides — copy to .env to activate.
#
# Every MOA_* var here has a built-in default. Settings in this file
# lose to shell-exported vars but win over harness/config.yaml.
#
# Built-in harnesses: {codex, claude, opencode, agy}. Built-in named
# providers: agy-gemini-pro, grok, codex-luna, codex, codex-sol, sonnet, opus,
# glm, minimax, muse-spark, deepseek-flash, fable. Qwen, Moonshot and MiMo are disabled.
# Add custom routes with MOA_PROVIDER_<NAME> or the providers: config block.
#
# CLI flags to run_moa.py override everything below.

# --- binary paths -----------------------------------------------------------
# Override only if the CLI is not on PATH or lives at a non-default location.
# MOA_CODEX_BIN=/usr/local/bin/codex
# MOA_CLAUDE_BIN=/usr/local/bin/claude
# MOA_OPENCODE_BIN=/usr/local/bin/opencode

# --- models -----------------------------------------------------------------
# MOA_CODEX_MODEL=gpt-6-astra
# MOA_CODEX_REVIEWER_MODEL=gpt-6.1-sol
# MOA_SONNET_MODEL=claude-sonnet-5-5
# MOA_AGGREGATOR_MODEL=opus       # optional model override; omit to use provider default
# MOA_GLM_MODEL=opencode-go/glm-5.3
# MOA_MINIMAX_MODEL=opencode-go/minimax-m3
# MOA_MUSE_SPARK_MODEL=opencode-go/muse-spark-1.3-contributor  # requires paid-training permission
# Qwen routes are disabled; archived manifests retain their model IDs.
# MOA_AGY_GEMINI_PRO_MODEL=gemini-4-argon-high
# MOA_GROK_MODEL=opencode-go/grok-4.7
# MOA_DEEPSEEK_FLASH_MODEL=opencode-go/deepseek-v4.1-flash
# Kimi and DeepSeek Pro are disabled for new launches.

# --- provider API keys ------------------------------------------------------
# Claude reads ANTHROPIC_API_KEY directly. OpenCode reads whichever provider
# key is set; no `opencode auth login` is needed for those providers.
# ANTHROPIC_API_KEY=...   # Sonnet via Claude Code CLI
# ZHIPU_API_KEY=...       # GLM via Zhipu / Z.ai (incl. GLM Coding Plan)
# FIREWORKS_API_KEY=...   # optional GLM via Fireworks serverless
# XAI_API_KEY=...         # optional direct xAI billing; the curated Grok route uses Go

# --- codex reasoning effort -------------------------------------------------
# One of: low, medium, high, xhigh.
# MOA_CODEX_EFFORT=high
# MOA_CODEX_REVIEWER_EFFORT=high
# MOA_AGGREGATOR_EFFORT=xhigh       # used by a Codex Layer-3 subprocess

# --- per-agent timeouts (seconds) -------------------------------------------
# Codex default scales with effort: xhigh=1500, high=1200, med/low=900.
# opencode + sonnet default to 1200; per-route caps may be configured.
# MOA_CODEX_TIMEOUT=1500
# MOA_SONNET_TIMEOUT=1200
# MOA_OPENCODE_TIMEOUT=1200
# Per-named-provider timeout: MOA_<NAME>_TIMEOUT (e.g. MOA_GLM_TIMEOUT=1500)

# --- Web UI attachment OCR -------------------------------------------------
# MOA_WEBUI_THREADS=32
# PDF pages OCR concurrently, then reassemble in original order. The defaults
# derive page workers from logical CPUs (max 12) and give each Tesseract
# process up to 3 OpenMP threads.
# MOA_ATTACHMENT_OCR_WORKERS=12
# MOA_ATTACHMENT_OCR_THREADS_PER_WORKER=3
# MOA_ATTACHMENT_OCR_LANG=eng

# --- layer / role selection -------------------------------------------------
# Comma-separated lists. Defaults use three proposer labs and two reviewer labs.
# MOA_PROPOSERS=agy-gemini-pro,grok,codex-luna
# MOA_REFINERS=deepseek-flash,opus
# MOA_AGGREGATOR=codex-sol         # default recorded Layer 3, xhigh
# MOA_AGGREGATOR=opus              # optional Claude aggregation
# MOA_SKIP_LAYER2=1   # set to skip refinement entirely

# --- user-named providers (shell/.env shorthand) ----------------------------
# Define a provider inline as MOA_PROVIDER_<NAME>=<harness>:<model>, then add
# <name> (lowercased, _ → -) to MOA_PROPOSERS / MOA_REFINERS. A full roster
# swap needs no config.yaml. YAML `providers:` wins on a name conflict.
#   MOA_PROVIDER_CUSTOM_REVIEW=opencode:provider/model-id
#   MOA_REFINERS=deepseek-flash,opus,custom-review
# Override a custom model with MOA_CUSTOM_REVIEW_MODEL=provider/model-id.

# --- optional Slack gateway (keep real values in a private file) -------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MOA_SLACK_TEAM_ID=T_WORKSPACE
# MOA_SLACK_BASE_URL=https://your-dashboard.example/moa-x
# MOA_SLACK_PRIVATE_REPOS=your-org/explicitly-approved-repository
# Optional private local JSON policy; never commit the deployment's real values.
# MOA_SLACK_REPO_POLICY_FILE=/etc/moa-x/repositories.json
